# Copy to .env and edit for your environment. Never commit .env.
APP_ENV=development
APP_NAME=MF Agent
LOG_LEVEL=INFO

SQL_SERVER=ALAMGIR-PC
SQL_DATABASE=DataAnalysis
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_CONNECTION_TIMEOUT=15
SQL_QUERY_TIMEOUT=30
SQL_MAX_ROWS=200

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

MAX_QUESTION_CHARS=1000
MAX_SQL_CHARS=12000
MAX_RESULT_BYTES=5000000
MAX_CONCURRENT_REQUESTS=2
AUDIT_LOG_PATH=logs/agent_audit.jsonl
REGISTRY_PATH=registry/master_registry.json
